{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEPSE-Impact-500 adjudicated record",
  "type": "object",
  "required": [
    "id",
    "documentId",
    "schemaVersion",
    "ontologyVersion",
    "title",
    "excerpt",
    "sentences",
    "contentHash",
    "duplicateGroupId",
    "source",
    "publishedAt",
    "generated",
    "gold",
    "model",
    "adjudicatedAt",
    "adjudicatedBy"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "documentId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 2 },
    "ontologyVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contentHash": { "type": "string", "minLength": 16 },
    "duplicateGroupId": { "type": "string", "minLength": 8 },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "generated": { "$ref": "#/$defs/label" },
    "gold": { "$ref": "#/$defs/label" },
    "annotations": { "type": "array", "items": { "type": "object" } },
    "model": { "type": "object" }
  },
  "$defs": {
    "label": {
      "type": "object",
      "required": [
        "language",
        "summary",
        "relevance",
        "eventType",
        "impactScope",
        "impactDirection",
        "impactHorizon",
        "impactMechanism",
        "sectors",
        "symbols",
        "tags",
        "confidenceBand",
        "rationale",
        "evidenceSentenceIds"
      ],
      "properties": {
        "language": { "enum": ["en", "ne", "mixed"] },
        "summary": { "type": "string", "minLength": 20 },
        "relevance": { "enum": ["direct", "indirect", "not_relevant"] },
        "eventType": {
          "enum": [
            "market_trading",
            "earnings",
            "capital_action",
            "governance",
            "project_operations",
            "credit_financing",
            "regulation",
            "monetary_liquidity",
            "fiscal_macroeconomic",
            "sector_industry",
            "other",
            "not_applicable"
          ]
        },
        "impactScope": { "enum": ["company", "sector", "market", "none"] },
        "impactDirection": {
          "enum": ["bullish", "bearish", "neutral", "uncertain", "not_applicable"]
        },
        "impactHorizon": {
          "enum": ["immediate", "short_term", "medium_term", "not_applicable"]
        },
        "impactMechanism": {
          "enum": [
            "earnings_cash_flow",
            "ownership_supply",
            "financing_liquidity",
            "regulation",
            "demand_revenue",
            "operations_capacity",
            "valuation_sentiment",
            "market_flow",
            "uncertain",
            "none"
          ]
        },
        "sectors": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "confidenceBand": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 20 },
        "evidenceSentenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^S[1-9][0-9]*$" }
        }
      }
    }
  }
}
