# Local Mac settings for connecting MarketGyan to a Lightning-hosted vLLM API.
# Copy this file to .env.lightning-agent and replace the endpoint/key values.

MARKET_GYAN_QUERY_ENABLED=true
MARKET_GYAN_AGENT_MOCK_ENABLED=false
MARKET_GYAN_AGENT_SERVICE_TOKEN=local-dev-token
MARKET_GYAN_NODE_BASE_URL=http://127.0.0.1:5001

MARKET_GYAN_INFERENCE_BASE_URL=https://YOUR-LIGHTNING-ENDPOINT/v1
MARKET_GYAN_INFERENCE_API_KEY=replace-with-vllm-api-key
MARKET_GYAN_INFERENCE_MODEL=marketgyan-qwen35-9b-targeted-v2
MARKET_GYAN_AGENT_TIMEOUT_SECONDS=180
MARKET_GYAN_AGENT_MAX_TOKENS=512
