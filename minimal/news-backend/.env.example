# Environment Variables for News Backend
# Copy to .env and fill in real values. Never commit .env.

# ── Core ───────────────────────────────────────────────────────────
# Server port and bind address
PORT=5001
HOST=0.0.0.0
# Set to "production" for deployments (enables strict secret and CORS checks)
NODE_ENV=development

# JWT secret: a long random string. Required in production; generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret for the admin-only article endpoints
# (POST /api/news, POST /api/news/bulk, DELETE /api/news/:id) via the
# x-admin-token header. Leave empty to disable those endpoints.
ADMIN_API_TOKEN=

# Comma-separated browser origins allowed to call the API. Empty = any origin
# in development and same-origin only in production.
CORS_ORIGINS=
# Set when running behind a reverse proxy (e.g. 1 for a single nginx hop)
TRUST_PROXY=
# Serve the React production build from this server (also: npm run start:app)
SERVE_FRONTEND=false

# ── MongoDB ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/newsDB
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=0
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_MAX_IDLE_TIME_MS=0
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_RETRY_DELAY_MS=1000
MONGODB_RETRY_MAX_DELAY_MS=30000

# ── News ingestion ─────────────────────────────────────────────────
# Articles older than this are deleted (bookmarked and Market Gyan articles are kept)
NEWS_RETENTION_DAYS=7
NEWS_UPDATE_INTERVAL_MINUTES=30

# ── Semantic search (Qdrant) ───────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Defaults to khabar_articles_<model>_<dims>
QDRANT_COLLECTION=
QDRANT_TIMEOUT_MS=10000
# "transformers" (multilingual model, default) or "hash" (offline hashing vectors).
# The two use separate collections; re-run `npm run index-qdrant` after switching.
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/distiluse-base-multilingual-cased-v2

# ── AI summaries, translation, speech ──────────────────────────────
# Summaries use the Gemini API first and fall back to the local mBART model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: minimal | low | medium | high (supported values depend on the model)
GEMINI_THINKING_LEVEL=
SUMMARY_API_TIMEOUT_MS=30000
# Local mBART (summaries fallback + English → Nepali translation)
MBART_MODEL=sagunrai/mbart-large-50-nepali-finetuned-1
# auto | cpu | cuda | mps
MBART_DEVICE=auto
MBART_TIMEOUT_MS=600000
# The model is unloaded after this much inactivity to free memory
MBART_IDLE_TIMEOUT_MS=600000
# Piper text-to-speech
TTS_TIMEOUT_MS=120000
TTS_IDLE_TIMEOUT_MS=600000
TTS_CACHE_MAX_FILES=500
TTS_CACHE_MAX_AGE_DAYS=14
# Python interpreter with torch/transformers/piper-tts installed
PYTHON_BIN=python3

# ── Email ──────────────────────────────────────────────────────────
# Using Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional custom From header, e.g. "Khabar AI" <news@example.com>
EMAIL_FROM=
# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
# Public URL of this API for unsubscribe links. Defaults to the FRONTEND_URL
# host on PORT.
PUBLIC_API_URL=
# Daily digest hours are interpreted in this time zone
NEWSLETTER_TIMEZONE=Asia/Kathmandu

# ── Market Gyan data pipeline ──────────────────────────────────────
# Uses a dedicated collection so finance/regulatory chunks remain isolated.
MARKET_GYAN_QDRANT_COLLECTION=market_gyan_documents
MARKET_GYAN_TIMEZONE=Asia/Kathmandu
MARKET_GYAN_POST_MARKET_CRON=30 15 * * 0-4
# Ingestion and model structuring are opt-in.
MARKET_GYAN_POST_MARKET_SCHEDULER_ENABLED=false
MARKET_GYAN_DIGEST_ENABLED=false
MARKET_GYAN_REVIEW_ENABLED=false
MARKET_GYAN_REVIEWER_ID=reviewer-1
MARKET_GYAN_REVIEWER_ROLE=primary
MARKET_GYAN_REVIEW_TARGET=500
MARKET_GYAN_SECOND_REVIEW_TARGET=110
# Retained for explicit schema-v1 pilot exports only.
MARKET_GYAN_APPROVED_TARGET=300
MARKET_GYAN_MIN_APPROVED_PER_SENTIMENT=50
MARKET_GYAN_STRUCTURING_ENABLED=false
MARKET_GYAN_QUERY_ENABLED=false
MARKET_GYAN_AGENT_SERVICE_URL=http://127.0.0.1:8100
MARKET_GYAN_AGENT_SERVICE_TOKEN=
MARKET_GYAN_AGENT_TIMEOUT_MS=120000
MARKET_GYAN_AGENT_TIMEOUT_SECONDS=120
MARKET_GYAN_NODE_BASE_URL=http://127.0.0.1:5001
MARKET_GYAN_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
MARKET_GYAN_INFERENCE_API_KEY=local
MARKET_GYAN_INFERENCE_MODEL=marketgyan-qwen3-8b
MARKET_GYAN_QDRANT_CHUNK_SIZE=1200
MARKET_GYAN_QDRANT_CHUNK_OVERLAP=150
MARKET_GYAN_GEMMA_MODEL=gemma-4-26b-a4b-it
MARKET_GYAN_GEMMA_RPM=15
MARKET_GYAN_GEMMA_CONCURRENCY=1
MARKET_GYAN_GEMMA_MAX_ATTEMPTS=4
MARKET_GYAN_GEMMA_BACKOFF_BASE_MS=5000
MARKET_GYAN_GEMMA_CIRCUIT_BREAKER_FAILURES=3
MARKET_GYAN_PROMPT_VERSION=market-impact-v2
MARKET_GYAN_SCHEMA_VERSION=2
MARKET_GYAN_REQUEST_TIMEOUT_MS=90000
MARKET_GYAN_SOURCE_THROTTLE_MS=750
