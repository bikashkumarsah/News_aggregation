{
  "name": "news-backend",
  "version": "1.0.0",
  "description": "News aggregator backend API with MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test features/marketGyan/tests/*.test.js",
    "market-gyan:ingest": "node features/marketGyan/scripts/marketGyan.js ingest",
    "market-gyan:backfill": "node features/marketGyan/scripts/marketGyan.js backfill",
    "market-gyan:queue": "node features/marketGyan/scripts/marketGyan.js queue",
    "market-gyan:queue-balanced": "node features/marketGyan/scripts/marketGyan.js queue-balanced",
    "market-gyan:select-v2": "node features/marketGyan/scripts/marketGyan.js select-v2",
    "market-gyan:queue-v2": "node features/marketGyan/scripts/marketGyan.js queue-v2",
    "market-gyan:process": "node features/marketGyan/scripts/marketGyan.js process",
    "market-gyan:retry": "node features/marketGyan/scripts/marketGyan.js retry",
    "market-gyan:assistant-review-export": "node features/marketGyan/scripts/marketGyan.js assistant-review-export",
    "market-gyan:assistant-review-import": "node features/marketGyan/scripts/marketGyan.js assistant-review-import",
    "market-gyan:adjudicate-submitted": "node features/marketGyan/scripts/marketGyan.js adjudicate-submitted",
    "market-gyan:rebalance-audit": "node features/marketGyan/scripts/marketGyan.js rebalance-audit",
    "market-gyan:rebalance-apply": "node features/marketGyan/scripts/marketGyan.js rebalance-apply",
    "market-gyan:import-revalidation-audit": "node features/marketGyan/scripts/marketGyan.js import-revalidation-audit",
    "market-gyan:status": "node features/marketGyan/scripts/marketGyan.js status",
    "market-gyan:index": "node features/marketGyan/scripts/marketGyan.js index",
    "market-gyan:report": "node features/marketGyan/scripts/marketGyan.js report",
    "market-gyan:reactions": "node features/marketGyan/scripts/marketGyan.js reactions",
    "market-gyan:sync-ontology": "node features/marketGyan/scripts/marketGyan.js sync-ontology",
    "market-gyan:export-reactions": "node features/marketGyan/scripts/marketGyan.js export-reactions",
    "market-gyan:export-labels": "node features/marketGyan/scripts/marketGyan.js export",
    "market-gyan:test-live-gemma": "MARKET_GYAN_LIVE_GEMMA_TEST=true node -r dotenv/config --test --test-name-pattern=\"live Gemma\" features/marketGyan/tests/structuring.test.js",
    "update-news": "node updateNews.js",
    "schedule-news": "node scheduleNews.js",
    "cleanup-old": "node cleanupOldNews.js",
    "index-qdrant": "node scripts/indexQdrant.js",
    "backfill-topics": "node scripts/backfillTopics.js"
  },
  "keywords": [
    "news",
    "aggregator",
    "rss",
    "mongodb",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.2",
    "natural": "^8.1.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^1.1.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
